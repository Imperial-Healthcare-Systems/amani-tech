# Copy to .env.local and fill in. Never commit .env.local.
# On Vercel, add the four variables marked VERCEL under Settings → Environment Variables and redeploy.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000   # VERCEL: your production URL

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co   # VERCEL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # VERCEL — sb_publishable_… (legacy anon JWT also works as NEXT_PUBLIC_SUPABASE_ANON_KEY)
SUPABASE_SERVICE_ROLE_KEY=            # VERCEL (secret) — server only: public form writes and private file access

# Email (SMTP). Leave EMAIL_HOST blank to skip sending (logged instead).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Amani Tech <no-reply@amanitech.in>"
ADMIN_NOTIFICATION_EMAIL=recruitment@amanitech.in

# Uploads & rate limiting
MAX_UPLOAD_MB=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=5
