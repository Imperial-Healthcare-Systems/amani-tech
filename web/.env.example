# Copy to .env.local and fill in. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only — used for public form writes and private file access

# Email (SMTP). Leave EMAIL_HOST blank to skip sending (logged instead).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Amani Tech <no-reply@amanitech.in>"
ADMIN_NOTIFICATION_EMAIL=recruitment@amanitech.in

# Uploads & rate limiting
MAX_UPLOAD_MB=5
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=5
